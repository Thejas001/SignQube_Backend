PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/signque_db?schema=public"
JWT_ACCESS_SECRET=your-super-secret-access-key
JWT_REFRESH_SECRET=your-super-secret-refresh-key
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SHIPPING_FEE=99
UPLOAD_MAX_FILE_SIZE=5242880
ADMIN_USERNAME=admin@signqube.com
ADMIN_PASSWORD=admin123
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR
RAZORPAY_COMPANY_NAME=SIGNQUE

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-bucket-name

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# Approved message templates, used when the customer's 24-hour service window
# has closed (free-form text can't be delivered then). Leave empty to disable.
# Payment confirmed: one body variable, {{1}} = order number.
# Re-engagement: no variables, e.g. "Hi! We have an update about your SIGNQUE order. Reply here to continue."
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE=
WHATSAPP_REENGAGEMENT_TEMPLATE=

# Razorpay payment links sent over WhatsApp expire after this many minutes (min 16)
RAZORPAY_PAYMENT_LINK_EXPIRY_MINUTES=1440

# OpenAI (or an OpenAI-compatible provider, e.g. Gemini's compat endpoint:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/, OPENAI_MODEL=gemini-flash-lite-latest)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Recent messages sent with each call. Order facts live in the draft, so older
# chat rarely matters; every extra message is re-sent on every call.
OPENAI_MAX_HISTORY_MESSAGES=12
OPENAI_MAX_TOKENS=500
# Optional, only for reasoning models (e.g. low | medium | high). Leave empty for gpt-4o-mini.
OPENAI_REASONING_EFFORT=
# Optional. Lower values (0.2-0.5) make tool arguments and facts more consistent.
OPENAI_TEMPERATURE=
# Per-call timeout and bounded retries (429/5xx/connection errors only).
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# Small catalogs are put straight into the agent's prompt (one call per product
# question) instead of being searched (two calls). Above this many characters of
# compact product list (~4 chars per token), the agent searches instead.
AGENT_INLINE_CATALOG_MAX_CHARS=1200
